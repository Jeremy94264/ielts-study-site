# 统一换行符，避免 Windows/macOS 协作时出现整文件 diff
* text=auto

# Windows 脚本保持 CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# 二进制文件
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary

# 文本类资源按文本处理
*.md text
*.mm text
*.json text
*.js text
*.css text
*.html text
